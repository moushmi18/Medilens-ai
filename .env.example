# MediLens AI Environment Configuration
# Copy this file to .env and update values as needed

# Application
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8247

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5847,http://127.0.0.1:5847

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=medilens
POSTGRES_PASSWORD=medilens_dev
POSTGRES_DB=medilens

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# JWT (CHANGE IN PRODUCTION!)
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_STRONG_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI (required for RAG in Phase 6+)
OPENAI_API_KEY=

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
